generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model courses {
  id                                                          Int             @id @default(autoincrement())
  name                                                        String          @db.VarChar(100)
  day                                                         String          @db.VarChar(20)
  start_time                                                  DateTime        @db.Time
  end_time                                                    DateTime        @db.Time
  modality                                                    String          @db.VarChar(20)
  difficulty                                                  String          @db.VarChar(20)
  credits                                                     Int
  prerequisites_prerequisites_course_idTocourses              prerequisites[] @relation("prerequisites_course_idTocourses")
  prerequisites_prerequisites_prerequisite_course_idTocourses prerequisites[] @relation("prerequisites_prerequisite_course_idTocourses")
}

model prerequisites {
  course_id              Int
  prerequisite_course_id Int
  course               courses @relation("CourseToPrerequisite", fields: [course_id], references: [id], onDelete: Cascade)
  prerequisite_course  courses @relation("PrerequisiteToCourse", fields: [prerequisite_course_id], references: [id], onDelete: Cascade)

  @@id([course_id, prerequisite_course_id])
}
